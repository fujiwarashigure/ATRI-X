# 原生二进制部署（不用容器）的 systemd 单元。
# 适用于你已经把 atri-x 二进制放到 /opt/atri-x/atri-x 的场景。
#
# 安装：
#   useradd -r -s /usr/sbin/nologin atri-x
#   mkdir -p /opt/atri-x/data/config /opt/atri-x/data/run
#   chown -R atri-x:atri-x /opt/atri-x
#   cp deploy/atri-x.service /etc/systemd/system/atri-x.service
#   systemctl daemon-reload && systemctl enable --now atri-x
#
# 注意：ATRI-X 是自动化 Agent，会按设计执行 shell / 写文件。下面的加固
# 只允许它写入 /opt/atri-x；如果你要让 Agent 管理其他目录（如 /www），
# 必须在 ReadWritePaths 中追加对应路径，或放宽 ProtectSystem。

[Unit]
Description=ATRI-X Agent Service
Documentation=https://github.com/Elflare/elbot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=atri-x
Group=atri-x
WorkingDirectory=/opt/atri-x

Environment=TZ=Asia/Shanghai
Environment=XDG_CONFIG_HOME=/opt/atri-x/data/config
Environment=XDG_DATA_HOME=/opt/atri-x/data
Environment=XDG_RUNTIME_DIR=/opt/atri-x/data/run
# .env 不存在时忽略，不阻止启动
EnvironmentFile=-/opt/atri-x/data/config/.env

ExecStart=/opt/atri-x/atri-x service run

Restart=always
RestartSec=5
TimeoutStopSec=40

# ---- 安全加固（可按需放宽）----
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/atri-x
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
